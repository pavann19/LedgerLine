* text=auto
*.sh text eol=lf
*.py text eol=lf
*.go text eol=lf
*.java text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
mvnw text eol=lf
*.png binary
*.jpg binary
*.pdf binary

# Unified patch context uses significant leading spaces on empty lines.
bench/baselines/*.patch -whitespace
