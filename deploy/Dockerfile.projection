# Multi-stage Dockerfile for projection-service
FROM eclipse-temurin:21-jdk-alpine AS builder
WORKDIR /workspace

COPY pom.xml mvnw mvnw.cmd ./
COPY .mvn .mvn
RUN chmod +x mvnw
COPY ledger-service/pom.xml ledger-service/
COPY projection-service/pom.xml projection-service/

COPY projection-service/src projection-service/src
RUN ./mvnw clean package -DskipTests -pl projection-service

FROM eclipse-temurin:21-jre-alpine
RUN apk upgrade --no-cache
WORKDIR /app
COPY --from=builder /workspace/projection-service/target/*.jar app.jar

EXPOSE 8081
ENTRYPOINT ["java", "-XX:+UseG1GC", "-XX:MaxRAMPercentage=75.0", "-jar", "app.jar"]
